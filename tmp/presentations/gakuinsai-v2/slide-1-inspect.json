      {
        "id": "sh/sryl4zqx",
        "kind": "textbox",
        "name": "正方形/長方形 6",
        "text": "TEDxWUSHS Youth とは",
        "position": {
          "left": 61.6,
          "top": 268,
          "width": 470,
          "height": 38
        },
        "style": {
